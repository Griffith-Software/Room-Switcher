<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tray icon, setup wizard, command line and single-instance pipe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>RoomSwitcher.App</RootNamespace>
    <AssemblyName>RoomSwitcher</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>RoomSwitcher.ico</ApplicationIcon>
    <Title>Room Switcher</Title>
    <Description>One PC, several workstations: switch displays, sound and devices between rooms from the system tray.</Description>
    <AssemblyTitle>Room Switcher</AssemblyTitle>
  </PropertyGroup>

  <!-- Release: one self-contained, compressed exe so nothing needs installing. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\RoomSwitcher-512.png" LogicalName="RoomSwitcher.App.Assets.RoomSwitcher-512.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoomSwitcher.Core\RoomSwitcher.Core.csproj" />
    <ProjectReference Include="..\RoomSwitcher.Windows\RoomSwitcher.Windows.csproj" />
  </ItemGroup>

</Project>
